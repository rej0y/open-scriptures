{
  "name": "open-scriptures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ensure": "bash -lc 'curl -sf http://127.0.0.1:1420/ >/dev/null || npm run dev'",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && npm run test:build && node --test --loader ./tests/node-test-loader.mjs .test-dist/tests/*.test.js && npm run test:browser",
    "test:build": "tsc -p tsconfig.test.json",
    "test:browser": "node --test ./tests/browser-ui.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.2"
  }
}
